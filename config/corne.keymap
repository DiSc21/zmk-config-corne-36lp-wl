╰──────────────────────────────────────────────────────────╯
╭──────────────────────────────────────────────────────────╮
│ @brief: ZMK keymap for Corne 5×3+3 — 8 layers           │
│                                                          │
│ @depends:                                                │
│ - shared_defs.dtsi (positions, timing, layers)           │
│ - behaviors_hrm.dtsi (home-row-modifiers)                │
│ - behaviors_led.dtsi (LED layer hold-taps)               │
│ - behaviors_multigrams.dtsi (multigram macros + MG-HRMs) │
│ - combos.dtsi (15 horizontal-adjacent combos)            │
╰──────────────────────────────────────────────────────────╯
*/

/* std includes */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

/* project includes */
#include "shared_defs.dtsi"
#include "behaviors_hrm.dtsi"
#include "behaviors_led.dtsi"
#include "behaviors_multigrams.dtsi"
#include "combos.dtsi"

&led_strip {
    chain-length = <24>;
};

/ {

    behaviors {
        /* BSP/DEL mod-morph: Shift+BSP→DEL, Shift+DEL→BSP */
        mm_bsp: mm_bsp {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&l_ht_nav L_NAV BSPC>, <&kp DEL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        mm_del: mm_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&r_ht_exo L_EXOTIC DEL>, <&kp BSPC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ═══════════════════════════════════════════════════════
         * Layer 0: Default
         * ╭─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────╮
         * │  Q  │  W  │  E  │  R  │  T  │ │  Y  │  U  │  I  │  O  │  P  │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │  A  │  S  │  D  │  F  │  G  │ │  H  │  J  │  K  │  L  │  ;  │
         * │ SFT │ CTL │ GUI │ ALT │     │ │     │ ALT │ GUI │ CTL │ SFT │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │  Z  │  X  │  C  │  V  │  B  │ │  N  │  M  │  ,  │  .  │  /  │
         * ╰─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────╯
         *             │ BSP │ RET │ TAB │ │ ESC │ SPC │ DEL │
         *             │Nav5 │Sym3 │Num1 │ │ MG6 │ FK2 │Exo4 │
         *             ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
         * ═══════════════════════════════════════════════════════ */
        default_layer {
            display-name = "default";
            bindings = <
                &none  &kp Q              &kp W             &kp E            &kp R             &kp T                &kp Y              &kp U             &kp I            &kp O             &kp P                &none
                &none  &ht_l_tr LSHIFT A  &ht_l_tr LCTRL S  &ht_l_tr LGUI D  &ht_l_tr LALT F   &kp G                &kp H              &ht_r_tr RALT J   &ht_r_tr RGUI K  &ht_r_tr RCTRL L  &ht_r_tr RSHIFT SEMI &none
                &none  &kp Z              &kp X             &kp C            &kp V             &kp B                &kp N              &kp M             &kp COMMA        &kp DOT           &kp FSLH             &none
                                                             &mm_bsp          &l_ht_sym L_SYM RET  &l_ht_num L_NUM TAB  &b_ht_mg L_MG ESC  &r_ht_fk L_FKEYS SPACE  &mm_del
            >;
        };

        /* ═══════════════════════════════════════════════════════
         * Layer 1: Numbers (TAB hold → right side)
         * ╭─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────╮
         * │     │     │     │     │     │ │  *  │  7  │  8  │  9  │  +  │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │ │  0  │  4  │  5  │  6  │  =  │
         * │ SFT │ CTL │ GUI │ ALT │     │ │     │     │     │     │     │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │ │  -  │  1  │  2  │  3  │  /  │
         * ╰─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────╯
         *             │     │     │*TAB*│ │     │     │     │
         *             ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
         * Left: base (HRMs active)  Right: numpad, no HRMs
         * ═══════════════════════════════════════════════════════ */
        numbers_layer {
            display-name = "numbers";
            bindings = <
                &none  &trans  &trans  &trans  &trans  &trans      &kp ASTERISK  &kp N7  &kp N8  &kp N9  &kp PLUS   &none
                &none  &trans  &trans  &trans  &trans  &trans      &kp N0        &kp N4  &kp N5  &kp N6  &kp EQUAL  &none
                &none  &trans  &trans  &trans  &trans  &trans      &kp MINUS     &kp N1  &kp N2  &kp N3  &kp FSLH   &none
                                       &trans  &trans  &trans      &trans        &trans  &trans
            >;
        };

        /* ═══════════════════════════════════════════════════════
         * Layer 2: F-Keys (SPC hold → left side)
         * ╭─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────╮
         * │ F12 │  F9 │  F8 │  F7 │ PgU │ │     │     │     │     │     │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │ F11 │  F6 │  F5 │  F4 │ PSc │ │     │     │     │     │     │
         * │     │     │     │     │     │ │     │ ALT │ GUI │ CTL │ SFT │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │ F10 │  F3 │  F2 │  F1 │ PgD │ │     │     │     │     │     │
         * ╰─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────╯
         *             │     │     │     │ │     │*SPC*│     │
         *             ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
         * Left: F-keys (no HRMs)  Right: base (HRMs active)
         * ═══════════════════════════════════════════════════════ */
        fkeys_layer {
            display-name = "f-keys";
            bindings = <
                &none  &kp F12  &kp F9  &kp F8  &kp F7  &kp PG_UP      &trans  &trans  &trans  &trans  &trans  &none
                &none  &kp F11  &kp F6  &kp F5  &kp F4  &kp PSCRN      &trans  &trans  &trans  &trans  &trans  &none
                &none  &kp F10  &kp F3  &kp F2  &kp F1  &kp PG_DN      &trans  &trans  &trans  &trans  &trans  &none
                                         &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };

        /* ═══════════════════════════════════════════════════════
         * Layer 3: Symbols (RET hold → right side)
         * ╭─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────╮
         * │     │     │     │     │     │ │  !  │  @  │  #  │  $  │  %  │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │ │  &  │  {  │  -  │  _  │  }  │
         * │ SFT │ CTL │ GUI │ ALT │     │ │     │     │     │     │     │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │ │  |  │  [  │  (  │  )  │  ]  │
         * ╰─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────╯
         *             │     │*RET*│     │ │     │     │     │
         *             ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
         * Left: base (HRMs active)  Right: symbols, no HRMs
         * ═══════════════════════════════════════════════════════ */
        symbols_layer {
            display-name = "symbols";
            bindings = <
                &none  &trans  &trans  &trans  &trans  &trans      &kp EXCL   &kp AT    &kp HASH   &kp DOLLAR  &kp PERCENT  &none
                &none  &trans  &trans  &trans  &trans  &trans      &kp AMPS   &kp LBRC  &kp MINUS  &kp UNDER   &kp RBRC     &none
                &none  &trans  &trans  &trans  &trans  &trans      &kp PIPE   &kp LBKT  &kp LPAR   &kp RPAR    &kp RBKT     &none
                                       &trans  &trans  &trans      &trans     &trans    &trans
            >;
        };

        /* ═══════════════════════════════════════════════════════
         * Layer 4: Exotic (DEL hold → left side)
         * ╭─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────╮
         * │  ~  │  `  │ TODO│  ^  │ TODO│ │     │     │     │     │     │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │ TODO│ TODO│ TODO│ TODO│ TODO│ │     │     │     │     │     │
         * │     │     │     │     │     │ │     │ ALT │ GUI │ CTL │ SFT │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │ TODO│ TODO│ TODO│ TODO│  $  │ │     │     │     │     │     │
         * ╰─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────╯
         *             │     │     │     │ │     │     │*DEL*│
         *             ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
         * Left: exotic (no HRMs, compose TBD)  Right: base (HRMs active)
         * TODO: ä ß ö ü € § £ ± × ¡ ¿ need compose sequences
         * ═══════════════════════════════════════════════════════ */
        exotic_layer {
            display-name = "exotic";
            bindings = <
                &none  &kp TILDE  &kp GRAVE  &none       &kp CARET  &none          &trans  &trans  &trans  &trans  &trans  &none
                &none  &none      &none      &none       &none      &none          &trans  &trans  &trans  &trans  &trans  &none
                &none  &none      &none      &none       &none      &kp DOLLAR     &trans  &trans  &trans  &trans  &trans  &none
                                              &trans      &trans     &trans         &trans  &trans  &trans
            >;
        };

        /* ═══════════════════════════════════════════════════════
         * Layer 5: Nav (BSP hold → right side)
         * ╭─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────╮
         * │     │     │     │     │     │ │ ScU │ LCl │ MCl │ RCl │ PgU │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │ │  ←  │  ↓  │  ↑  │  →  │     │
         * │ SFT │ CTL │ GUI │ ALT │     │ │     │     │     │     │     │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │ │ ScD │ HOM │     │ END │ PgD │
         * ╰─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────╯
         *             │*BSP*│     │     │ │     │     │     │
         *             ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
         * Left: base (HRMs active)  Right: nav + mouse, no HRMs
         * ═══════════════════════════════════════════════════════ */
        nav_layer {
            display-name = "nav";
            bindings = <
                &none  &trans  &trans  &trans  &trans  &trans      &msc SCRL_UP    &mkp LCLK   &mkp MCLK  &mkp RCLK  &kp PG_UP  &none
                &none  &trans  &trans  &trans  &trans  &trans      &kp LEFT        &kp DOWN    &kp UP     &kp RIGHT  &none      &none
                &none  &trans  &trans  &trans  &trans  &trans      &msc SCRL_DOWN  &kp HOME    &none      &kp END    &kp PG_DN  &none
                                       &trans  &trans  &trans      &trans          &trans      &trans
            >;
        };

        /* ═══════════════════════════════════════════════════════
         * Layer 6: Multigrams (ESC hold → both sides)
         * ╭─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────╮
         * │ qu  │ wh  │ er  │ re  │ th  │ │ you │uous │ ish │ough │ ph  │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │ and │ st  │ ing │ for │ ion │ │ ght │ che │ ful │ ly  │ness │
         * │MGSFT│MGCTL│MGGUI│  —  │  —  │ │  —  │  —  │MGGUI│MGCTL│MGSFT│
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │ at  │ sh  │ ch  │ ed  │ ble │ │ not │ment │true │false│tion │
         * ╰─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────╯
         *             │ BSP │ RET │ TAB │ │*ESC*│ SPC │ DEL │
         *             ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
         * Both sides: multigrams with MG-HRMs (consumed modifiers)
         * Thumbs: plain taps (no layer stacking), ESC=trans (layer hold)
         * ═══════════════════════════════════════════════════════ */
        multigrams_layer {
            display-name = "multigrams";
            bindings = <
                &none  &mg_qu                  &mg_wh                 &mg_er                &mg_re   &mg_th       &mg_you  &mg_uous  &mg_ish                &mg_ough                &mg_ph                    &none
                &none  &mghr_l_and LSHIFT 0    &mghr_l_st LCTRL 0     &mghr_l_ing LGUI 0    &mg_for  &mg_ion      &mg_ght  &mg_che   &mghr_r_ful RGUI 0     &mghr_r_ly RCTRL 0      &mghr_r_ness RSHIFT 0     &none
                &none  &mg_at                  &mg_sh                 &mg_ch                &mg_ed   &mg_ble      &mg_not  &mg_ment  &mg_tru                &mg_fls                 &mg_tion                  &none
                                                                       &kp BSPC              &kp RET  &kp TAB      &trans   &kp SPACE &kp DEL
            >;
        };

        /* ═══════════════════════════════════════════════════════
         * Layer 7: BT/LED (one-shot via T+Y combo)
         * ╭─────┬─────┬─────┬─────┬─────╮ ╭─────┬─────┬─────┬─────┬─────╮
         * │BTCLR│     │     │     │     │ │     │ TOG │ HU+ │ SA+ │ BR+ │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │ BT1 │ BT2 │ BT3 │ BT4 │ BT5 │ │     │ EF← │ SP- │ SP+ │ EF→ │
         * ├─────┼─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┼─────┤
         * │     │     │     │     │     │ │     │     │ HU- │ SA- │ BR- │
         * ╰─────┴─────┼─────┼─────┼─────┤ ├─────┼─────┼─────┼─────┴─────╯
         *             │ DEF │ DEF │ DEF │ │ DEF │ DEF │ DEF │
         *             ╰─────┴─────┴─────╯ ╰─────┴─────┴─────╯
         * All unassigned keys → &to L_DEF (safe exit)
         * ═══════════════════════════════════════════════════════ */
        bt_led_layer {
            display-name = "bt-led";
            bindings = <
                &none  &bt BT_CLR    &to L_DEF     &to L_DEF     &to L_DEF     &to L_DEF          &to L_DEF  &rgb_ug RGB_TOG  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &none
                &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4       &to L_DEF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &none
                &none  &to L_DEF     &to L_DEF     &to L_DEF     &to L_DEF     &to L_DEF          &to L_DEF  &to L_DEF        &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &none
                                                    &tol_def      &tol_def      &tol_def           &tol_def   &tol_def         &tol_def
            >;
        };

    };
};

